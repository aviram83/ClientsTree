
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  language  String     @default("he")
  createdAt DateTime   @default(now())
  treeNodes TreeNode[]
  resetTokenHash      String?    @unique
  resetTokenExpiresAt DateTime?
}

model TreeNode {
  id              String           @id @default(uuid())
  name            String
  status          ClientStatus
  percentageLevel PercentageLevel? @default(LEVEL_6)
  description     String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  parent   TreeNode?  @relation("TreeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children TreeNode[] @relation("TreeHierarchy")

  // getTree and the move endpoint's cycle check both scan all of a user's
  // nodes by userId — index it so that scan stays cheap as trees grow.
  @@index([userId])
}

enum ClientStatus {
  CLIENT_VIP
  DISTRIBUTOR
  SUPERVISOR
  CLIENT
}

enum PercentageLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_6
}
